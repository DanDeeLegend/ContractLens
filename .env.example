# --- Server-side only (never prefix with VITE_, or it would be bundled into the browser) ---

# JSON-RPC endpoint for Ethereum Sepolia, e.g. an Alchemy URL. Contains your API key.
# Locally: put it in .env. On Vercel: Project Settings > Environment Variables.
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>

# Optional: extra origins allowed to call /api/rpc (comma separated). Same-origin is always allowed.
# ALLOWED_ORIGINS=https://my-other-site.example

# --- Public (safe to expose; shipped in the client bundle) ---

# Contract used by the landing page's "Try Demo Contract" button.
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
